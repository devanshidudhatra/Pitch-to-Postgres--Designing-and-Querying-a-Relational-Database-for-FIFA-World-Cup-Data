# Pitch to Postgres - database settings.
# Copy this file to .env and fill in the values. Never commit .env.
# Only this file changes when switching between the local test database and the course server.

# --- Local test database (PostgreSQL on your own computer) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=worldcup
DB_USER=postgres
DB_PASSWORD=your_local_password_here
# Optional: schema to create/use the tables in (leave empty for the default 'public')
DB_SCHEMA=

# --- Course server (use on the university network only) ---
# DB_HOST=10.100.71.21
# DB_PORT=5432                      # use the port given by the instructor
# DB_NAME=your_database_name        # given by the instructor
# DB_USER=your_username             # given by the instructor
# DB_PASSWORD=your_password         # given by the instructor
# DB_SCHEMA=                        # only if the instructor asks you to use a specific schema
